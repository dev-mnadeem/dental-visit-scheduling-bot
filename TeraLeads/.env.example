# Environment Variables for Docker Compose
# Copy this file to .env and update with your values

# Node Environment
NODE_ENV=development

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=chatbot_db
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production-min-32-characters

# LLM Provider Configuration
# auto = use a hosted model when its key is set below, and the local
# rule-based model when it is not. Copying this file as-is gives you a
# working system with no credentials.
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# CORS Configuration
CORS_ORIGIN=http://localhost:3400
CORS_ORIGINS=http://localhost:3400

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3401
NEXT_PUBLIC_WS_URL=ws://localhost:3401
